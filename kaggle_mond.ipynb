# In a Kaggle notebook

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

import roman_mond as rm

# 1. Load Roman-like catalog
df = rm.load_roman_catalog("roman_galaxies.csv")  # or parquet
galaxies = rm.preprocess_roman_data(df)

# 2. Pick one galaxy
gid = list(galaxies.keys())[0]
g = galaxies[gid]

r = g["r"]
v_obs = g["v_obs"]
v_err = g["v_err"]
M_star = g["M_star"]
M_gas = g["M_gas"]

# 3. MOND model (no EFE)
v_mond = rm.model_v_mond(r, M_star, M_gas, a_ext=0.0, mu_func_name="simple")

# 4. Optional ΛCDM fit
popt_lcdm, _ = rm.fit_lcdm_rotation_curve(r, v_obs, v_err, M_star, M_gas)
M_halo_fit = popt_lcdm[0]
v_lcdm = rm.model_v_lcdm(r, M_star, M_gas, M_halo_fit)

# 5. Plot
rm.plot_rotation_curves(r, v_obs, v_err, v_mond, v_lcdm, galaxy_id=gid,
                        save_path="rotation_curve.png")

rm.plot_residuals(r, v_obs, v_err, v_mond, model_name="MOND", galaxy_id=gid,
                  save_path="mond_residuals.png")
